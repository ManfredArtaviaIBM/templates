":["category"]},{"key":"value","value":null,"switchState":"path","valueMapping":["value"]}],"switchState":"path","transformations":[{"id":"0ed15589-c1f6-456e-8e66-ef75a8fbc6ab","path":[""],"type":"customFunction","customFunction":"const apps = data.applications || []\n\nlet totals = {\n  \"Priority 1\": 0,\n  \"Priority 2\": 0,\n  \"Priority 3\": 0\n}\n\napps.forEach(app => {\n  totals[\"Priority 1\"] += Number(app.priority_1_findings) || 0\n  totals[\"Priority 2\"] += Number(app.priority_2_findings) || 0\n  totals[\"Priority 3\"] += Number(app.priority_3_findings) || 0\n})\n\nreturn Object.entries(totals).map(([category, value]) => ({\n  category,\n  value\n}))","cachedIntrospection":{"key":"root","type":"array","fields":[{"key":"category","type":"string","exampleData":"Priority 1"},{"key":"value","type":"number","exampleData":"60"}]}}],"updatedAt":"2026-03-25T15:58:56.616Z","value":null,"valueMapping":[],"widgetId":"fa5e0c3e-f3ff-4ee7-95f6-575380b341ec"},{"id":"cdb605ba-21d5-44b6-84ae-96e4461806a9","createdAt":"2026-03-25T15:58:56.616Z","key":"legendAlignment","subProperties":[],"switchState":"value","transformations":[],"updatedAt":"2026-03-25T15:58:56.616Z","value":"bottom","valueMapping":[],"widgetId":"fa5e0c3e-f3ff-4ee7-95f6-575380b341ec"}],"gridItem":{"id":"a865db23-35a6-47ae-b1c4-c36a5f635e9f","createdAt":"2026-03-24T22:15:08.797Z","desktop":{"h":39,"w":3,"x":9,"y":49},"mobile":{"h":43,"w":12,"x":0,"y":61},"showInDesktop":true,"showInMobile":true,"updatedAt":"2026-03-26T16:34:12.487Z","widgetId":"fa5e0c3e-f3ff-4ee7-95f6-575380b341ec"}},{"id":"e1008c66-033c-45cf-87a5-715fc7837583","card":{"icon":null,"name":"Markdown Text","title":null,"subTitle":null},"content":{"tag":"markdown-text"},"createdAt":"2026-03-24T22:15:06.866Z","name":"markdown-text","pageId":"1cc80160-e8be-4ddd-a3ef-2b95aee86adb","type":"markdownText","updatedAt":"2026-03-26T16:21:47.877Z","actions":[],"adapter":[{"id":"60ad4f7b-acc8-4ea7-a8ba-509783b589a1","actionId":null,"createdAt":"2026-03-24T22:15:07.896Z","dataSourceId":null,"type":"static","updatedAt":"2026-03-26T16:21:47.877Z","widgetId":"e1008c66-033c-45cf-87a5-715fc7837583","bodyJsonData":[],"bodyType":null,"data":null,"endPointUrl":null,"graphqlArgumentMetadata":[],"headers":[],"method":null,"operation":null,"pollingInterval":null,"pollingOn":null,"requestPayload":null,"timeout":null,"urlParameters":[],"variables":null}],"contentProperties":[{"id":"ceb10e6e-8bd6-4d07-8692-80792adf64d6","createdAt":"2026-03-26T16:21:47.877Z","key":"text","subProperties":[],"switchState":"value","transformations":[],"updatedAt":"2026-03-26T16:21:47.877Z","value":"### Step 3: Apply a Custom Transformation\n\nBecause each application contains multiple priority fields (`priority_1_findings`, etc.), we need to aggregate the data by priority and compute totals. Add a **transformation** type: `Custom function` and use the following code:\n```javascript\nconst apps = data.applications || []\nlet totals = {\"Priority 1\": 0,\"Priority 2\": 0,\"Priority 3\": 0}\napps.forEach(app => {\n  totals[\"Priority 1\"] += Number(app.priority_1_findings) || 0\n  totals[\"Priority 2\"] += Number(app.priority_2_findings) || 0\n  totals[\"Priority 3\"] += Number(app.priority_3_findings) || 0})\nreturn Object.entries(totals).map(([category, value]) => ({\n  category,value}))\n```\nThis aggregates all Apps and returns a summarized structure grouped by priority, ready for donut, pie, or aggregated bar visualizations.","valueMapping":[],"widgetId":"e1008c66-033c-45cf-87a5-715fc7837583"}],"gridItem":{"id":"2c928f85-108b-4072-8d9f-1e45567229e2","createdAt":"2026-03-24T22:15:08.038Z","desktop":{"h":53,"w":5,"x":4,"y":12},"mobile":{"h":4,"w":12,"x":0,"y":27},"showInDesktop":true,"showInMobile":true,"updatedAt":"2026-03-26T16:34:12.485Z","widgetId":"e1008c66-033c-45cf-87a5-715fc7837583"}}]}],"resourceStates":[],"exportVersion":1}